<Window x:Class="DriftHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DriftHub"
        Title="DriftHub" Height="760" Width="1180" MinHeight="650" MinWidth="980"
        Background="#0A0D12" Foreground="#F3F5F7" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#121820"/>
        <SolidColorBrush x:Key="PanelSoft" Color="#171F28"/>
        <SolidColorBrush x:Key="Line" Color="#27323D"/>
        <SolidColorBrush x:Key="Muted" Color="#8B98A6"/>
        <SolidColorBrush x:Key="Accent" Color="#FF684A"/>
        <SolidColorBrush x:Key="Green" Color="#3DD68C"/>
        <local:PreviewImageConverter x:Key="PreviewImage"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B2530"/><Setter Property="Foreground" Value="#F3F5F7"/>
            <Setter Property="BorderBrush" Value="#33414E"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#293746"/><Setter Property="BorderBrush" Value="#FF684A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0F151C"/><Setter Property="Foreground" Value="#F3F5F7"/><Setter Property="BorderBrush" Value="#2B3743"/><Setter Property="CaretBrush" Value="#F3F5F7"/><Setter Property="Padding" Value="10,8"/></Style>
        <Style TargetType="ProgressBar"><Setter Property="Height" Value="5"/><Setter Property="Background" Value="#26313B"/><Setter Property="Foreground" Value="#FF684A"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Window.Resources>
    <Grid>
        <Grid Margin="28,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="112"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource Accent}" Margin="0,0,13,0"><TextBlock Text="D" FontSize="23" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel><TextBlock Text="DRIFTHUB" FontSize="20" FontWeight="Black"/><TextBlock Text="MAP INSTALLER / GTA V" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="1,2,0,0"/></StackPanel>
                    <TextBlock x:Name="VersionLabel" Text="v1.1.0" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="GtaPathBox" Width="390" Margin="0,0,8,0" IsReadOnly="True" ToolTip="Папка с GTA V"/>
                    <Button x:Name="BrowseBtn" Content="Выбрать GTA" Click="BrowseBtn_Click" Margin="0,0,7,0"/><Button x:Name="AutoBtn" Content="Автопоиск" Click="AutoBtn_Click"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#101820" BorderBrush="#263540" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse x:Name="BaseDot" Width="10" Height="10" Fill="#66727D" VerticalAlignment="Center" Margin="0,0,11,0"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="БАЗОВЫЙ МАППИНГ" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="BaseStatus" Text="Проверка установки" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock x:Name="BaseDetail" Text="" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><ProgressBar x:Name="BusyBar" Width="100" Visibility="Collapsed" Margin="0,0,12,0"/><Button x:Name="InstallBaseBtn" Content="Установить базу" Click="InstallBaseBtn_Click" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Margin="0,0,8,0"/><Button x:Name="RestoreBtn" Content="Восстановить" Click="RestoreBtn_Click"/></StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                    <TextBlock Text="DRIFT SPOTS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SpotsHint" Text="" Foreground="{StaticResource Muted}" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SpotsGrid" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="252" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Margin="8">
                                    <StackPanel>
                                        <Grid Height="150">
                                            <Border Background="#0F151C" CornerRadius="10,10,0,0"/>
                                            <TextBlock Text="Нет preview" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding Preview, Converter={StaticResource PreviewImage}}" Stretch="UniformToFill">
                                                <Image.Clip><RectangleGeometry Rect="0,0,252,150" RadiusX="10" RadiusY="10"/></Image.Clip>
                                            </Image>
                                        </Grid>
                                        <StackPanel Margin="13,11,13,13">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" Margin="0,4,0,2"/>
                                            <TextBlock Text="{Binding YmapEntry}" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" Margin="0,0,0,9"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="не установлен"/><Setter Property="Foreground" Value="#8B98A6"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsInstalled}" Value="True"><Setter Property="Text" Value="установлен ✓"/><Setter Property="Foreground" Value="#3DD68C"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Grid.Column="1" Tag="{Binding}" Click="SpotToggle_Click" Padding="12,6" FontSize="12">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Content" Value="Установить"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsInstalled}" Value="True"><Setter Property="Content" Value="Убрать"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <TextBox x:Name="LogBox" Grid.Row="3" Margin="0,18,0,0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}"/>
        </Grid>
        <Border x:Name="StartupOverlay" Background="#E60A0D12" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                <Border Width="54" Height="54" CornerRadius="14" Background="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,14"><TextBlock Text="D" FontSize="29" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="DRIFTHUB" FontSize="18" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock x:Name="StartupText" Text="Загрузка..." Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,14"/>
                <ProgressBar IsIndeterminate="True" Height="5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
