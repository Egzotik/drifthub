<Window x:Class="DriftHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DriftHub"
        Title="DriftHub by Infinity Mods" Height="780" Width="1200" MinHeight="650" MinWidth="980"
        Background="#000000" Foreground="#F5F5F7" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#0C0C0E"/>
        <SolidColorBrush x:Key="Line" Color="#26262B"/>
        <SolidColorBrush x:Key="Muted" Color="#8E8E93"/>
        <SolidColorBrush x:Key="Accent" Color="#E10600"/>
        <SolidColorBrush x:Key="AccentLight" Color="#FF2A2A"/>
        <local:PreviewImageConverter x:Key="PreviewImage"/>
        <LinearGradientBrush x:Key="LogoGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6B6B" Offset="0"/><GradientStop Color="#E10600" Offset="0.55"/><GradientStop Color="#7A0000" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A1A1D"/><Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#3A3A40"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A0A0A"/><Setter Property="BorderBrush" Value="#E10600"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0A0A0C"/><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="BorderBrush" Value="#2E2E33"/><Setter Property="CaretBrush" Value="#F5F5F7"/><Setter Property="Padding" Value="10,8"/></Style>
        <Style TargetType="ProgressBar"><Setter Property="Height" Value="5"/><Setter Property="Background" Value="#260A0A"/><Setter Property="Foreground" Value="#E10600"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Window.Resources>
    <Grid>
        <Grid Margin="30,22,30,12">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="0.55">
                    <GradientStop Color="#160404" Offset="0"/><GradientStop Color="#000000" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="13" Background="#0B0B0D" BorderBrush="#E10600" BorderThickness="1.5" Margin="0,0,13,0">
                        <Grid Margin="7">
                            <Path x:Name="VectorLogo" Stretch="Uniform" Stroke="{StaticResource LogoGrad}" StrokeThickness="9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 60 30 C 60 15, 45 8, 33 12 C 17 17, 17 43, 33 48 C 45 52, 60 45, 60 30 C 60 15, 75 8, 87 12 C 103 17, 103 43, 87 48 C 75 52, 60 45, 60 30">
                                <Path.Effect><DropShadowEffect Color="#E10600" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/></Path.Effect>
                            </Path>
                            <Image x:Name="LogoImg" Visibility="Collapsed" Stretch="Uniform"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DRIFTHUB" FontSize="21" FontWeight="Black"/>
                            <Border CornerRadius="9" BorderBrush="#E10600" BorderThickness="1" Margin="10,0,0,0" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionLabel" Text="v1.2.1" Foreground="{StaticResource AccentLight}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="by Infinity Mods" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="1,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="GtaPathBox" Width="330" Margin="0,0,8,0" IsReadOnly="True" ToolTip="Папка с GTA V"/>
                    <Button x:Name="BrowseBtn" Content="Выбрать GTA" Click="BrowseBtn_Click" Margin="0,0,7,0"/><Button x:Name="AutoBtn" Content="Автопоиск" Click="AutoBtn_Click" Margin="0,0,7,0"/><Button x:Name="CheckUpdatesBtn" Content="Обновления" Click="CheckUpdatesBtn_Click"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#0D0505" BorderBrush="#3A1010" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Rectangle Width="3" Fill="{StaticResource Accent}" RadiusX="1.5" RadiusY="1.5" Margin="0,0,12,0"/>
                    <Ellipse x:Name="BaseDot" Grid.Column="1" Width="10" Height="10" Fill="#55555A" VerticalAlignment="Center" Margin="0,0,11,0"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="БАЗОВЫЙ МАППИНГ" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="BaseStatus" Text="Проверка установки" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/><TextBlock x:Name="BaseDetail" Text="" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><ProgressBar x:Name="BusyBar" Width="100" Visibility="Collapsed" Margin="0,0,12,0"/><Button x:Name="InstallBaseBtn" Content="Установить базу" Click="InstallBaseBtn_Click" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Margin="0,0,8,0"/><Button x:Name="RestoreBtn" Content="Восстановить" Click="RestoreBtn_Click"/></StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                    <TextBlock Text="DRIFT SPOTS" Foreground="#F5F5F7" FontSize="13" FontWeight="Black" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SpotsHint" Text="" Foreground="{StaticResource Muted}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="SpotsScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SpotsGrid" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="272" Background="{StaticResource Panel}" BorderBrush="#26262B" BorderThickness="1" CornerRadius="12" Margin="9" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="5" Opacity="0.65"/></Border.Effect>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#26262B"/>
                                                <Style.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard><Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.15"/>
                                                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" To="#E10600" Duration="0:0:0.15"/>
                                                        </Storyboard></BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard><Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.18"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.18"/>
                                                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" To="#26262B" Duration="0:0:0.18"/>
                                                        </Storyboard></BeginStoryboard>
                                                    </EventTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid Height="168">
                                                <Border Background="#08080A" CornerRadius="12,12,0,0"/>
                                                <Path Stretch="Uniform" Height="66" Opacity="0.14" Stroke="#E10600" StrokeThickness="9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 60 30 C 60 15, 45 8, 33 12 C 17 17, 17 43, 33 48 C 45 52, 60 45, 60 30 C 60 15, 75 8, 87 12 C 103 17, 103 43, 87 48 C 75 52, 60 45, 60 30"/>
                                                <Image Source="{Binding Preview, Converter={StaticResource PreviewImage}}" Stretch="UniformToFill">
                                                    <Image.Clip><RectangleGeometry Rect="0,0,272,168" RadiusX="12" RadiusY="12"/></Image.Clip>
                                                </Image>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" CornerRadius="11" Padding="10,4" Background="#CC000000">
                                                    <TextBlock FontSize="10" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="НЕ УСТАНОВЛЕН"/><Setter Property="Foreground" Value="#8E8E93"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding IsInstalled}" Value="True"><Setter Property="Text" Value="● В ИГРЕ"/><Setter Property="Foreground" Value="#FF3B30"/></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            <StackPanel Margin="15,12,15,15">
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Black" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis" Margin="0,5,0,3"/>
                                                <TextBlock Text="{Binding YmapEntry}" Foreground="#55555A" FontFamily="Consolas" FontSize="10" Margin="0,0,0,11"/>
                                                <Button Tag="{Binding}" Click="SpotToggle_Click" HorizontalAlignment="Stretch" Padding="12,9" FontSize="13">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Content" Value="Установить"/>
                                                            <Setter Property="Background" Value="#E10600"/><Setter Property="BorderBrush" Value="#E10600"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True"><Setter Property="Content" Value="Убрать"/><Setter Property="Background" Value="#1A1A1D"/><Setter Property="BorderBrush" Value="#3A3A40"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Stretch="Uniform" Height="72" Opacity="0.22" Stroke="#E10600" StrokeThickness="9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                              Data="M 60 30 C 60 15, 45 8, 33 12 C 17 17, 17 43, 33 48 C 45 52, 60 45, 60 30 C 60 15, 75 8, 87 12 C 103 17, 103 43, 87 48 C 75 52, 60 45, 60 30"/>
                        <TextBlock Text="Спотов пока нет" FontSize="17" FontWeight="Black" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                        <TextBlock x:Name="EmptyHint" Text="" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <TextBlock x:Name="StatusLine" Grid.Row="3" Foreground="#55555A" FontSize="11" Margin="2,10,0,0" TextTrimming="CharacterEllipsis" Text="Готов."/>
        </Grid>
        <Border x:Name="StartupOverlay" Background="#F2000000" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                <Border Width="92" Height="92" CornerRadius="24" Background="#0B0B0D" BorderBrush="#E10600" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Grid Margin="12">
                        <Path x:Name="OverlayVectorLogo" Stretch="Uniform" Stroke="{StaticResource LogoGrad}" StrokeThickness="9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 60 30 C 60 15, 45 8, 33 12 C 17 17, 17 43, 33 48 C 45 52, 60 45, 60 30 C 60 15, 75 8, 87 12 C 103 17, 103 43, 87 48 C 75 52, 60 45, 60 30">
                            <Path.Effect><DropShadowEffect Color="#E10600" BlurRadius="22" ShadowDepth="0" Opacity="0.7"/></Path.Effect>
                        </Path>
                        <Image x:Name="OverlayLogoImg" Visibility="Collapsed" Stretch="Uniform"/>
                    </Grid>
                </Border>
                <TextBlock Text="DRIFTHUB" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="by Infinity Mods" Foreground="{StaticResource AccentLight}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock x:Name="StartupText" Text="Загрузка..." Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,14" TextWrapping="Wrap" TextAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Height="5"/>
                <Button Content="Продолжить без проверки" Click="StartupSkip_Click" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="12,6" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
